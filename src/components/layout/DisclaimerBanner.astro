---
---

<div id="disclaimer-banner" class="banner" style="position:relative">
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="flex-shrink:0">
    <circle cx="8" cy="8" r="6.5" stroke="#3F5D52" stroke-width="1.3"/>
    <path d="M8 5v4M8 10.5v.5" stroke="#3F5D52" stroke-width="1.3" stroke-linecap="round"/>
  </svg>
  <span>
    <strong>Informational only.</strong>
    Estimates are based on published clinical trial averages and are not medical advice.
    Individual results vary. Always consult your healthcare provider.
  </span>
  <button
    id="dismiss-disclaimer"
    style="position:absolute;right:16px;top:50%;transform:translateY(-50%);color:#6B655C;line-height:1"
    aria-label="Dismiss"
  >
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  </button>
</div>

<script>
  const STORAGE_KEY = "glpdash-disclaimer-dismissed";
  const banner = document.getElementById("disclaimer-banner");
  const dismissButton = document.getElementById("dismiss-disclaimer");

  if (localStorage.getItem(STORAGE_KEY) === "true") {
    banner?.remove();
  }

  dismissButton?.addEventListener("click", () => {
    localStorage.setItem(STORAGE_KEY, "true");
    banner?.remove();
  });
</script>
