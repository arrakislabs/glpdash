---
---

<div
  id="disclaimer-banner"
  class="bg-[#F59E0B]/10 border-b border-[#F59E0B]/30 px-4 py-3"
>
  <div class="max-w-6xl mx-auto flex items-start justify-between gap-4">
    <div class="flex items-start gap-3">
      <svg class="shrink-0 mt-0.5" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M8 1.5L1 14h14L8 1.5z" stroke="#F59E0B" stroke-width="1.5" stroke-linejoin="round"/>
        <path d="M8 6v4M8 11.5v.5" stroke="#F59E0B" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <p class="text-xs text-[#94A3B8]">
        <span class="font-medium text-[#F59E0B]">Informational only.</span>{" "}
        Estimates are based on published clinical trial averages and are not medical advice.
        Individual results vary. Consult your healthcare provider before starting any medication.
      </p>
    </div>
    <button
      id="dismiss-disclaimer"
      class="shrink-0 text-[#94A3B8] hover:text-[#F8FAFC] transition-colors"
      aria-label="Dismiss"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</div>

<script>
  const STORAGE_KEY = "glpdash-disclaimer-dismissed";
  const banner = document.getElementById("disclaimer-banner");
  const dismissButton = document.getElementById("dismiss-disclaimer");

  if (localStorage.getItem(STORAGE_KEY) === "true") {
    banner?.remove();
  }

  dismissButton?.addEventListener("click", () => {
    localStorage.setItem(STORAGE_KEY, "true");
    banner?.remove();
  });
</script>
