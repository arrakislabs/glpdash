---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="site-logo" href="/">
          <span class="logo-dot"></span>
          <span class="logo-mark">GLP <em>Index</em></span>
        </a>
        <p class="footer-blurb">
          Independent, free, and cited. A small reference for people taking — or considering — GLP&#8209;1 medication.
        </p>
      </div>
      <div>
        <h5>Calculators</h5>
        <a href="/weight-loss-timeline">Weight Loss Timeline</a>
        <a href="/cost-comparison">Drug Cost Comparison</a>
        <a href="/dose-schedule">Dose Schedule</a>
      </div>
      <div>
        <h5>Method</h5>
        <a href="/#sources">Trial sources</a>
        <a href="/about#data">How we project</a>
        <a href="/about#updated">Last data update</a>
      </div>
      <div>
        <h5>About</h5>
        <a href="/about">Who runs this</a>
        <a href="/privacy">Privacy</a>
        <a href="mailto:hello@glpdash.com">Contact</a>
      </div>
    </div>

    <p class="disclaim">
      <strong>Not medical advice.</strong> All projections are based on published clinical-trial averages. Individual results vary substantially — based on starting weight, adherence, diet, activity, metabolism, and other factors. Always consult your healthcare provider before starting, changing, or stopping any medication.
    </p>

    <div class="footer-bottom">
      <span>© {year} GLP Index · glpdash.com</span>
      <span>v.2026.05</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 64px 0 40px;
    background: #FBFAF7;
    border-top: 1px solid #E0DAD0;
    margin-top: 80px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 40px;
  }

  /* Logo (reuse header styles inline since scoped) */
  .site-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-bottom: 10px;
  }

  .logo-dot {
    width: 10px;
    height: 10px;
    background: #3F5D52;
    border-radius: 2px;
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .logo-mark {
    font-family: "Fraunces", serif;
    font-weight: 500;
    font-size: 20px;
    letter-spacing: -0.015em;
    color: #1A1815;
  }

  .logo-mark em { font-style: italic; color: #3F5D52; font-weight: 400; }

  .footer-blurb {
    font-size: 13px;
    color: #6B655C;
    margin-top: 8px;
    max-width: 32ch;
    line-height: 1.55;
  }

  .site-footer h5 {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1A1815;
    margin-bottom: 14px;
  }

  .site-footer a {
    display: block;
    color: #6B655C;
    margin-bottom: 8px;
    font-size: 14px;
    transition: color 0.15s;
  }

  .site-footer a:hover { color: #3F5D52; }

  /* Override for logo link */
  .site-logo.site-logo { display: inline-flex; margin-bottom: 0; }

  .disclaim {
    padding-top: 24px;
    border-top: 1px solid #E0DAD0;
    font-size: 12px;
    color: #6B655C;
    line-height: 1.65;
    max-width: 100%;
  }

  .disclaim strong { color: #1A1815; font-weight: 600; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 24px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #6B655C;
  }

  @media (max-width: 880px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
</style>
