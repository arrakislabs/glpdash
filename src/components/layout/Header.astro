---
const navLinks = [
  { href: "/weight-loss-timeline/", label: "Weight Loss" },
  { href: "/cost-comparison/", label: "Drug Costs" },
  { href: "/dose-schedule/", label: "Dose Schedule" },
  { href: "/about/", label: "About" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <a class="site-logo" href="/">
      <span class="logo-dot"></span>
      <span class="logo-mark">GLP <em>Index</em></span>
      <span class="logo-sub">by glpdash.com</span>
    </a>

    <nav class="primary-nav" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={currentPath.startsWith(link.href) ? "current" : ""}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a class="nav-cta" href="/weight-loss-timeline/">Start a projection</a>

    <button id="mobile-menu-toggle" class="mobile-toggle" aria-label="Open menu" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-nav" hidden>
    <nav class="wrap" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={currentPath.startsWith(link.href) ? "current" : ""}
        >
          {link.label}
        </a>
      ))}
      <a href="/weight-loss-timeline/" class="mobile-cta">Start a projection →</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.hidden;
    if (menu) menu.hidden = isOpen;
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid #E0DAD0;
    background: #FBFAF7;
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(8px);
  }

  .site-header .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  /* Logo */
  .site-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .logo-dot {
    width: 10px;
    height: 10px;
    background: #3F5D52;
    border-radius: 2px;
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .logo-mark {
    font-family: "Fraunces", serif;
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.015em;
    color: #1A1815;
  }

  .logo-mark em {
    font-style: italic;
    color: #3F5D52;
    font-weight: 400;
  }

  .logo-sub {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: #6B655C;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-left: 4px;
  }

  /* Primary nav */
  .primary-nav {
    display: flex;
    gap: 28px;
    align-items: center;
  }

  .primary-nav a {
    font-size: 14px;
    color: #3A352E;
    font-weight: 500;
    padding: 6px 0;
    position: relative;
    transition: color 0.15s;
  }

  .primary-nav a:hover { color: #3F5D52; }

  .primary-nav a.current { color: #3F5D52; }

  .primary-nav a.current::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: #3F5D52;
  }

  /* CTA buttons */
.nav-cta {
    padding: 8px 14px;
    border: 1px solid #1A1815;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    transition: all 0.15s;
  }

  .nav-cta:hover { background: #1A1815; color: #FBFAF7; }

/* Mobile toggle */
  .mobile-toggle { display: none; color: #6B655C; padding: 4px; }

  /* Mobile nav */
  .mobile-nav {
    border-top: 1px solid #E0DAD0;
    background: #FBFAF7;
  }

  .mobile-nav nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 12px;
    padding-bottom: 16px;
  }

  .mobile-nav a {
    padding: 10px 0;
    font-size: 15px;
    font-weight: 500;
    color: #3A352E;
    border-bottom: 1px solid #EDE7DC;
  }

  .mobile-nav a.current { color: #3F5D52; }
  .mobile-nav a:last-child { border-bottom: none; }

  .mobile-cta {
    margin-top: 8px;
    color: #3F5D52 !important;
    font-weight: 500;
    border-bottom: none !important;
  }

  @media (max-width: 880px) {
    .primary-nav { display: none; }
    .nav-cta { display: none; }
    .mobile-toggle { display: flex; }
  }
</style>
