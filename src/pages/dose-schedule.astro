---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import DisclaimerBanner from "../components/layout/DisclaimerBanner.astro";
import DoseScheduleCalculator from "../components/calculators/DoseScheduleCalculator";
---

<BaseLayout
  title="GLP-1 Dose Escalation Schedule Generator | GLPDash"
  description="Generate your personal GLP-1 injection schedule with exact dates for every dose increase. Download as a calendar file for Wegovy, Ozempic, Mounjaro, or Zepbound."
>
  <Header />
  <DisclaimerBanner />

  <main class="max-w-3xl mx-auto px-4 py-10">
    <div class="mb-8">
      <nav class="flex items-center gap-2 text-xs text-[#94A3B8] mb-4">
        <a href="/" class="hover:text-[#F8FAFC] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#F8FAFC]">Dose Schedule</span>
      </nav>
      <h1 class="text-3xl font-bold text-[#F8FAFC] tracking-tight">Dose Escalation Schedule</h1>
      <p class="mt-2 text-[#94A3B8]">
        Generate your personal injection schedule with exact dates. Download it to your calendar so you never miss a dose increase.
      </p>
    </div>

    <DoseScheduleCalculator client:load />
  </main>

  <Footer />
</BaseLayout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GLP-1 Dose Escalation Schedule Generator",
  "url": "https://glpdash.com/dose-schedule",
  "applicationCategory": "HealthApplication",
  "description": "Generate a personal GLP-1 dose escalation schedule with exact dates and download as an .ics calendar file.",
  "offers": { "@type": "Offer", "price": "0" }
}
</script>
