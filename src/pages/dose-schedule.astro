---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import DoseScheduleCalculator from "../components/calculators/DoseScheduleCalculator";
---

<BaseLayout
  title="Dose Schedule — GLP Index"
  description="Generate a personal GLP-1 dose escalation schedule with exact dates for Wegovy, Ozempic, Mounjaro, or Zepbound. Export to Apple Calendar or Google Calendar."
>
  <Header />

  <section class="page-head">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">GLP Index</a>
        <span class="sep">/</span>
        <span class="now">Dose Schedule</span>
      </div>
      <h1 class="serif" style="font-weight:500;font-size:clamp(36px,4.4vw,52px);max-width:22ch">
        When do you step up — and to <em>what?</em>
      </h1>
      <p class="deck" style="margin-top:14px;font-size:17px;max-width:60ch">
        A personal escalation plan with exact dates, built from the FDA prescribing information for your medication. Drop it into your calendar in one click.
      </p>
    </div>
  </section>

  <div class="wrap" style="padding-bottom:80px">
    <DoseScheduleCalculator client:load />
  </div>

  <Footer />
</BaseLayout>

<style>
  .page-head {
    padding: 48px 0 32px;
    border-bottom: 1px solid #E0DAD0;
  }
</style>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GLP-1 Dose Escalation Schedule Generator",
  "url": "https://glpdash.com/dose-schedule",
  "applicationCategory": "HealthApplication",
  "description": "Generate a personal GLP-1 dose escalation schedule with exact dates and download as an .ics calendar file.",
  "offers": { "@type": "Offer", "price": "0" }
}
</script>
