---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ProviderBar from "../components/ProviderBar.astro";
import ProviderCards from "../components/ProviderCards.astro";
---

<BaseLayout
  title="GLP Index — Plain answers about your GLP-1"
  description="Independent calculators for Ozempic, Wegovy, Wegovy HD, Mounjaro, and Zepbound. Weight loss projections, real costs, and dose schedules built on the published clinical-trial data your doctor reads."
>
  <Header />
  <ProviderBar />

  <main>
    <!-- Hero -->
    <section class="hero-pad" style="border-bottom:1px solid #E0DAD0;padding-top:24px;padding-bottom:48px">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <div class="eyebrow">Independent · clinically grounded · free</div>
            <h1 style="margin-top:24px;max-width:18ch">
              Plain answers about <em>your</em> GLP&#8209;1, from the trials your doctor reads.
            </h1>
            <p class="lede" style="margin-top:20px">
              An index of weight loss projections, real costs, and dose schedules for <strong>Ozempic, Wegovy, Wegovy HD, Mounjaro, and Zepbound</strong> — calculated in your browser, from the published clinical&#8209;trial endpoints. Nothing is sent anywhere.
            </p>
            <div class="cta-row">
              <a class="btn btn-p" href="/weight-loss-timeline/">
                See my projected timeline <span class="arr">→</span>
              </a>
              <a class="btn btn-s" href="/cost-comparison/">Compare costs</a>
            </div>
            <div class="reassure">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 1.5l5.5 2v4c0 3.5-2.3 6.5-5.5 7.5-3.2-1-5.5-4-5.5-7.5v-4l5.5-2z" stroke="#3F5D52" stroke-width="1.3"/>
                <path d="M5.5 8l2 2 3.5-4" stroke="#3F5D52" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
              Your weight isn't sent anywhere — not even to us.
            </div>
          </div>

          <aside class="factcard">
            <div class="fc-label">STEP UP · Wegovy HD · 72 weeks</div>
            <div class="fc-number serif">−20.7<sub>%</sub></div>
            <div class="fc-cap">
              Average body weight reduction on semaglutide 7.2mg vs. −14.4% on standard 2.4mg dose.
              <strong>The highest semaglutide result in any published trial.</strong>
            </div>
            <div class="fc-source">
              <a class="cite" href="#sources">Source → N Engl J Med, 392:1501 (2025)</a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- Tools -->
    <section class="section">
      <div class="wrap">
        <div class="section-eyebrow">01 — The tools</div>
        <h2 class="section-title serif">Three questions, three answers.</h2>
        <p class="deck">Each calculator answers a single question — with sources visible and your data never leaving your browser.</p>

        <div class="tools-grid">
          <a class="tool-card" href="/weight-loss-timeline/">
            <span class="tool-num">No. 01</span>
            <h3 class="serif">Weight Loss Timeline</h3>
            <div class="tool-question">How much weight will I really lose?</div>
            <p>Week&#8209;by&#8209;week projection using your starting weight, your goal, and the actual STEP / SURMOUNT trial curves for your medication.</p>
            <span class="tool-open">Start with my numbers</span>
          </a>
          <a class="tool-card" href="/cost-comparison/">
            <span class="tool-num">No. 02</span>
            <h3 class="serif">Drug Cost Comparison</h3>
            <div class="tool-question">What will I actually pay each month?</div>
            <p>Retail, GoodRx, insurance, and telehealth pricing side by side. Refreshed this month, with the math shown.</p>
            <span class="tool-open">See real prices</span>
          </a>
          <a class="tool-card" href="/dose-schedule/">
            <span class="tool-num">No. 03</span>
            <h3 class="serif">Dose Schedule</h3>
            <div class="tool-question">When do I step up — and to what?</div>
            <p>A personal escalation plan with exact dates you can drop into Apple Calendar or Google Calendar in one click.</p>
            <span class="tool-open">Generate my schedule</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Sources -->
    <section class="section" id="sources">
      <div class="wrap">
        <div class="section-eyebrow">02 — What the math is built on</div>
        <h2 class="section-title serif">Five trials. Cited every time we project a number.</h2>
        <p class="deck">No proprietary models. No telehealth partnerships. No marketing data. Only the published endpoints — the same ones your prescriber sees.</p>

        <div class="sources-grid">
          <div class="source-card">
            <div class="source-label">Trial · 2025</div>
            <h4 class="serif">STEP UP</h4>
            <p>Semaglutide 7.2 mg (Wegovy HD) vs. 2.4 mg in adults with obesity. 72 weeks. −20.7% on HD dose.</p>
            <div class="source-pub">NEJM 392:1501 ↗</div>
          </div>
          <div class="source-card">
            <div class="source-label">Trial · 2021</div>
            <h4 class="serif">STEP 1</h4>
            <p>Semaglutide 2.4 mg vs. placebo in overweight or obese adults without diabetes. 1,961 participants. 68 weeks.</p>
            <div class="source-pub">NEJM 384:989 ↗</div>
          </div>
          <div class="source-card">
            <div class="source-label">Trial · 2021</div>
            <h4 class="serif">STEP 2</h4>
            <p>Semaglutide 2.4 mg in adults with type 2 diabetes and obesity. 1,210 participants.</p>
            <div class="source-pub">Lancet 397:971 ↗</div>
          </div>
          <div class="source-card">
            <div class="source-label">Trial · 2022</div>
            <h4 class="serif">SURMOUNT-1</h4>
            <p>Tirzepatide 5/10/15 mg vs. placebo in obesity without diabetes. 2,539 participants. 72 weeks.</p>
            <div class="source-pub">NEJM 387:205 ↗</div>
          </div>
          <div class="source-card">
            <div class="source-label">Trial · 2021</div>
            <h4 class="serif">SURPASS-2</h4>
            <p>Tirzepatide vs. semaglutide 1 mg in type 2 diabetes. 1,879 participants. 40 weeks.</p>
            <div class="source-pub">NEJM 385:503 ↗</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust -->
    <section class="section" style="border-bottom:none">
      <div class="wrap">
        <div class="section-eyebrow">03 — Why this exists</div>
        <h2 class="section-title serif">Three reasons to use this instead of asking a chatbot or scrolling Reddit.</h2>

        <div class="trust-grid">
          <div class="trust-item">
            <h4 class="serif">
              <svg class="trust-ico" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <path d="M11 2.2l7.7 2.8v5.5c0 4.8-3.3 9-7.7 10.5-4.4-1.5-7.7-5.7-7.7-10.5V5L11 2.2z" stroke="currentColor" stroke-width="1.4"/>
              </svg>
              Your numbers stay on your phone.
            </h4>
            <p>No accounts. No cookies. No servers receiving your weight. The calculations run inside your browser tab. We genuinely can't see what you typed — there's nowhere for it to go.</p>
          </div>
          <div class="trust-item">
            <h4 class="serif">
              <svg class="trust-ico" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="8.3" stroke="currentColor" stroke-width="1.4"/>
                <path d="M7.5 11l2.5 2.5 4.5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
              We're not selling you a prescription.
            </h4>
            <p>No telehealth partnerships. No affiliate links inside the calculators. If we ever add affiliate links anywhere, they'll be labelled — and never inside the medical math.</p>
          </div>
          <div class="trust-item">
            <h4 class="serif">
              <svg class="trust-ico" width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <rect x="3.5" y="4.5" width="15" height="15" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
                <path d="M3.5 9h15M8 2.5v4M14 2.5v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
              Bring the printout to your appointment.
            </h4>
            <p>Every calculator exports a clean, doctor&#8209;readable PDF. Walk in with the citations and your projection. Walk out with a plan you both understand.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <ProviderCards />

  <Footer />
</BaseLayout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 64px;
    align-items: end;
  }

  .cta-row {
    margin-top: 40px;
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }

  .reassure {
    margin-top: 22px;
    font-size: 13px;
    color: #6B655C;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Fact card */
  .factcard {
    background: #FBFAF7;
    border: 1px solid #E0DAD0;
    border-radius: 10px;
    padding: 24px;
    position: relative;
  }

  .factcard::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 24px;
    width: 48px;
    height: 2px;
    background: #3F5D52;
  }

  .fc-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6B655C;
    margin-bottom: 14px;
  }

  .fc-number {
    font-family: "Fraunces", serif;
    font-weight: 400;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .fc-number sub { font-size: 24px; color: #6B655C; font-weight: 400; }

  .fc-cap { font-size: 13px; color: #3A352E; margin-top: 8px; line-height: 1.5; }

  .fc-source {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px dashed #E0DAD0;
  }

  /* Tools grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #E0DAD0;
    border: 1px solid #E0DAD0;
    border-radius: 10px;
    overflow: hidden;
  }

  .tool-card {
    background: #FBFAF7;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: background 0.15s;
    min-height: 300px;
    text-decoration: none;
  }

  .tool-card:hover { background: #FFFEFB; }

  .tool-num {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #6B655C;
    letter-spacing: 0.12em;
  }

  .tool-card h3 {
    font-size: 24px;
    margin-top: 4px;
  }

  .tool-card p { font-size: 14px; color: #3A352E; line-height: 1.55; }

  .tool-question {
    margin-top: 8px;
    padding: 12px 14px;
    background: #E8EDE9;
    border-radius: 6px;
    font-style: italic;
    font-family: "Fraunces", serif;
    font-size: 15px;
    color: #2A3F38;
    font-weight: 400;
  }

  .tool-question::before { content: "\201C "; color: #3F5D52; }
  .tool-question::after { content: " \201D"; color: #3F5D52; }

  .tool-open {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #3F5D52;
    font-weight: 500;
  }

  .tool-open::after { content: "→"; transition: transform 0.15s; }
  .tool-card:hover .tool-open::after { transform: translateX(4px); }

  /* Sources */
  .sources-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  .source-card {
    background: #FBFAF7;
    border: 1px solid #E0DAD0;
    border-radius: 8px;
    padding: 18px;
  }

  .source-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    color: #6B655C;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .source-card h4 {
    font-family: "Fraunces", serif;
    font-weight: 500;
    font-size: 18px;
    margin: 6px 0 4px;
    letter-spacing: -0.01em;
  }

  .source-card p { font-size: 12px; color: #6B655C; line-height: 1.5; }

  .source-pub {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed #E0DAD0;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: #3F5D52;
  }

  /* Trust */
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    align-items: start;
    background: #FBFAF7;
    padding: 48px 40px;
    border-radius: 10px;
    border: 1px solid #E0DAD0;
  }

  .trust-item h4 {
    font-family: "Fraunces", serif;
    font-weight: 500;
    font-size: 20px;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .trust-ico { flex-shrink: 0; color: #3F5D52; }
  .trust-item p { font-size: 13px; color: #3A352E; line-height: 1.55; }

  /* Responsive */
  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; gap: 36px; }
    .tools-grid { grid-template-columns: 1fr; }
    .sources-grid { grid-template-columns: 1fr 1fr; }
    .trust-grid { grid-template-columns: 1fr; padding: 32px 24px; }
  }

  @media (max-width: 640px) {
    .hero-grid { gap: 24px; }
    .factcard { padding: 18px; }
    .sources-grid { grid-template-columns: 1fr; }
    .cta-row { flex-direction: column; align-items: flex-start; gap: 10px; }
  }
</style>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GLP Index",
  "url": "https://glpdash.com",
  "description": "Free GLP-1 calculators for Ozempic, Wegovy, Wegovy HD, Mounjaro, and Zepbound."
}
</script>
