---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import WeightLossCalculator from "../components/calculators/WeightLossCalculator";
import ProviderCallout from "../components/ProviderCallout.astro";
---

<BaseLayout
  title="Weight Loss Timeline — GLP Index"
  description="Project your weight loss week-by-week on Wegovy, Wegovy HD, Ozempic, Mounjaro, or Zepbound — from the actual STEP and SURMOUNT trial curves."
>
  <Header />

  <section class="page-head">
    <div class="wrap">
      <div class="crumbs">
        <a href="/">GLP Index</a>
        <span class="sep">/</span>
        <span class="now">Weight Loss Timeline</span>
      </div>
      <h1 class="serif" style="font-weight:500;font-size:clamp(36px,4.4vw,52px);max-width:22ch">
        How much weight will <em>you</em> really lose?
      </h1>
      <p class="deck" style="margin-top:14px;font-size:17px;max-width:58ch">
        Your projected curve, week by week, calculated from the same clinical-trial data your prescriber reads. Move the inputs — the chart and milestones update live. Nothing is sent anywhere.
      </p>
    </div>
  </section>

  <div class="wrap" style="padding-bottom:80px">
    <WeightLossCalculator client:load />
  </div>

  <ProviderCallout variant="section" />

  <Footer />
</BaseLayout>

<style>
  .page-head {
    padding: 48px 0 32px;
    border-bottom: 1px solid #E0DAD0;
  }
</style>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GLP-1 Weight Loss Timeline Calculator",
  "url": "https://glpdash.com/weight-loss-timeline",
  "applicationCategory": "HealthApplication",
  "description": "Estimate weekly weight loss on Ozempic, Wegovy, Wegovy HD, Mounjaro, or Zepbound based on clinical trial data.",
  "offers": { "@type": "Offer", "price": "0" }
}
</script>
